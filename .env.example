# Client public environment — NO secrets (only NEXT_PUBLIC_* public keys).
# Copy to .env.local and fill in. See docs/architecture.md §10.

# Backend API base URL. Optional during Stage 1 (mock data); required from Stage 3.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# One of: development | preview | production
NEXT_PUBLIC_APP_ENV=development
