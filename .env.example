# Base URL of the MozudKhata backend API (include the version prefix).
# In local dev the Vite proxy forwards /api to the backend, so the default
# same-origin relative path works without CORS. Set an absolute URL for
# deployed environments, e.g. https://api.mozudkhata.example.com/api/v1
VITE_API_URL=/api/v1

# Optional: where the Vite dev-server proxy forwards /api during `npm run dev`.
# VITE_DEV_API_PROXY=http://localhost:4000
